# ==============================================================================
# NavJyoti Frontend Environment Configuration Example
# Copy this file to .env or .env.local when integrating with the backend service.
# ==============================================================================

# API Base URL (FastAPI / Express / Django Gateway)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Environment (development, staging, production)
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_STORAGE=true
VITE_ENABLE_SMS_SIMULATION=true
VITE_ENABLE_OFFLINE_SYNC=true

# National UIP Health Record Resolver Gateway
VITE_HEALTH_PASS_PUBLIC_URL=http://localhost:5173/records/lookup
