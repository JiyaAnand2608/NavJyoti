# ==============================================================================
# NavJyoti Backend Environment Configuration Template (.env.example)
# Copy to .env and configure appropriate values before running the application.
# ==============================================================================

# Application Environment: 'production', 'development', or 'testing'
ENVIRONMENT=development

# Database Configuration (PostgreSQL with psycopg3 driver)
# Either provide full DATABASE_URL or individual DB parameters:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/navjyoti
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=navjyoti

# JWT Authentication Security
# CRITICAL: In production, generate a secure random 32+ byte string (e.g. `openssl rand -hex 32`)
# Production startup will fail safely if JWT_SECRET_KEY is not configured.
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Health Worker & Supervisor OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Email Dispatch Configuration (SMTP for live email delivery)
# When SMTP credentials are not configured, the backend logs OTP delivery in safe mock mode for development/testing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@navjyoti.gov.in
SMTP_USE_TLS=true
